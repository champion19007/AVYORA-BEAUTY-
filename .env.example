# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any standard Postgres connection string. Neon today, RDS/Aurora after the
# AWS move — nothing else in the codebase changes.
#   Neon: https://neon.tech -> project -> connection string (pooled)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Customer sign-in (Auth.js + Google)
# ---------------------------------------------------------------------------
# Generate the secret with:  openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Authorised redirect URI must be exactly:
#   http://localhost:9002/api/auth/callback/google      (local)
#   https://YOUR-DOMAIN/api/auth/callback/google        (production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Admin panel (separate from customer sign-in)
# ---------------------------------------------------------------------------
# Generate with:  node scripts/hash-password.mjs 'your-admin-password'
ADMIN_USERNAME=admin

# PBKDF2 hash, as pbkdf2:<iterations>:<salt>:<hash>. The password is never stored.
ADMIN_PASSWORD_HASH=

# Signs admin session cookies. At least 32 characters.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Email sign-in codes (optional) — Resend
# ---------------------------------------------------------------------------
# resend.com -> API Keys. EMAIL_FROM must be an address on a domain you have
# verified with Resend, or mail is rejected or lands in spam.
#
# Without these, the "email me a code" option is not offered at all — better
# than offering it and sending nothing.
RESEND_API_KEY=
EMAIL_FROM="Avyora <hello@yourdomain.com>"

# ---------------------------------------------------------------------------
# SMS sign-in codes (optional) — MSG91
# ---------------------------------------------------------------------------
# Transactional SMS to Indian numbers requires DLT registration with TRAI:
# your business registered with an operator, and the message template approved
# in advance. This is a legal requirement, not a provider one — messages from
# an unregistered sender are dropped by the carriers.
#
#   msg91.com -> Auth Key, and the approved OTP template id.
#
# Without these, the "use mobile number" option is not offered.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# Demo allowlist (optional) — for showing sign-in methods before they are live
# ---------------------------------------------------------------------------
# Email codes cannot reach anyone but the Resend account owner until a sending
# domain is verified, and SMS cannot be delivered at all until DLT registration
# completes. Both take time; the features are finished now.
#
# List your own addresses and numbers here and those identifiers may use those
# methods anyway — the code is shown on screen instead of being sent.
#
# Safe only because of the allowlist: an identifier that is not listed is
# refused before a code is generated, so nobody can type their own address and
# read a code back. A configured provider always wins, so this turns itself off
# per channel as each goes live. Unset means no identifiers, which means the
# mechanism does nothing. REMOVE IT once both channels are live.
#
#   DEMO_IDENTIFIERS=you@example.com,9876543210
DEMO_IDENTIFIERS=

# ---------------------------------------------------------------------------
# Order notifications
# ---------------------------------------------------------------------------
# Where the shop's own copy of each order goes. The customer's confirmation is
# sent regardless (it needs RESEND_API_KEY above); this is the alert to you.
OWNER_EMAIL=

# WhatsApp alerts via Meta's Cloud API — developers.facebook.com/apps
#   WHATSAPP_TOKEN            permanent access token for the app
#   WHATSAPP_PHONE_NUMBER_ID  the sending number's id, not the number itself
#   WHATSAPP_TO               where alerts go, with country code, e.g. 918369682814
#
# A business-initiated message outside a 24-hour window must use an approved
# template or it is silently dropped. Name yours here once it is approved;
# without it, alerts only arrive while a conversation window is already open.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Public site URL, used to build the order link inside the confirmation email.
NEXT_PUBLIC_SITE_URL=https://avyora-beauty.vercel.app

# ---------------------------------------------------------------------------
# Abandoned reservation sweep
# ---------------------------------------------------------------------------
# Stock is reserved when an order is created, before payment. Cancellation and
# payment failure return it — but a customer who simply closes the tab fires
# neither, so those units would sit reserved forever.
#
# Vercel Cron calls /api/cron/sweep every 15 minutes (see vercel.json) and the
# endpoint requires this secret: left open, it would be a way for anyone to
# cancel pending orders on demand. Without it set, the sweep refuses to run
# rather than running unauthenticated.
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# GST invoicing
# ---------------------------------------------------------------------------
# Your registration. Without SELLER_GSTIN the invoice page says so plainly
# rather than printing an invalid tax invoice.
#
# SELLER_STATE decides the tax split: a buyer in the same state is billed
# CGST + SGST, anyone else IGST. Same total either way — different heads at
# filing time.
SELLER_NAME=Avyora
SELLER_GSTIN=
SELLER_STATE=Maharashtra

# ---------------------------------------------------------------------------
# Payments (Razorpay)
# ---------------------------------------------------------------------------
# Razorpay Dashboard -> Settings -> API Keys -> Generate Key.
# Start in Test mode; live keys need completed KYC.
# The secret is shown once at creation and never again.
#
# Without these, checkout still works but offers cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
#   URL:    https://YOUR-DOMAIN/api/webhooks/razorpay
#   Events: payment.captured, payment.failed
# The webhook is the authoritative record of payment: the browser callback can
# be lost (closed tab, dead connection), so money must not depend on it.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# After setting DATABASE_URL
# ---------------------------------------------------------------------------
#   npm run db:migrate            apply the schema
#   npm run db:seed-inventory 25  create stock rows with 25 units each
#
# Stock control only takes effect once inventory rows exist: a SKU with no row
# is treated as unlimited, so the shop keeps working until you opt in.

# ---------------------------------------------------------------------------
# Error monitoring (optional)
# ---------------------------------------------------------------------------
# sentry.io -> create a project -> Client Keys (DSN).
#
# Without a DSN nothing is sent anywhere and the SDK never initialises;
# structured JSON error logs still go to stdout, which Vercel collects today
# and CloudWatch will collect after the AWS move.
#
# NEXT_PUBLIC_ is required for the browser half. Session replay is disabled in
# code: it records what customers type, which on checkout means addresses.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
