# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any standard Postgres connection string. Neon today, RDS/Aurora after the
# AWS move — nothing else in the codebase changes.
#   Neon: https://neon.tech -> project -> connection string (pooled)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Customer sign-in (Auth.js + Google)
# ---------------------------------------------------------------------------
# Generate the secret with:  openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Authorised redirect URI must be exactly:
#   http://localhost:9002/api/auth/callback/google      (local)
#   https://YOUR-DOMAIN/api/auth/callback/google        (production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Admin panel (separate from customer sign-in)
# ---------------------------------------------------------------------------
# Generate with:  node scripts/hash-password.mjs 'your-admin-password'
ADMIN_USERNAME=admin

# PBKDF2 hash, as pbkdf2:<iterations>:<salt>:<hash>. The password is never stored.
ADMIN_PASSWORD_HASH=

# Signs admin session cookies. At least 32 characters.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Email: sign-in codes and order emails (optional) — Gmail, or Resend
# ---------------------------------------------------------------------------
# Gmail with an app password (Google account -> Security -> 2-Step
# Verification -> App passwords). Mail is always sent from GMAIL_USER. About
# 500 messages a day; move to Resend before real volume. Gmail wins if both
# are set.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# resend.com -> API Keys. EMAIL_FROM must be an address on a domain you have
# verified with Resend, or mail is rejected or lands in spam.
#
# Without these, the "email me a code" option is not offered at all — better
# than offering it and sending nothing.
RESEND_API_KEY=
EMAIL_FROM="Avyora <hello@yourdomain.com>"

# ---------------------------------------------------------------------------
# SMS codes for sign-in and guest checkout (optional)
# ---------------------------------------------------------------------------
# First configured wins: Twilio Verify, then Fast2SMS, then MSG91. With any of
# them set, guests must verify their mobile number at checkout.
#
# Twilio Verify: Twilio creates, sends and checks the code; no Twilio number or
# DLT registration needed. Use an API key (Console -> API keys), not the auth
# token, and a Verify service (Console -> Verify -> Services). A trial only
# sends to verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# Fast2SMS OTP route: needs website verification in the Fast2SMS panel first.
FAST2SMS_API_KEY=

# MSG91:
# Transactional SMS to Indian numbers requires DLT registration with TRAI:
# your business registered with an operator, and the message template approved
# in advance. This is a legal requirement, not a provider one — messages from
# an unregistered sender are dropped by the carriers.
#
#   msg91.com -> Auth Key, and the approved OTP template id.
#
# Without these, the "use mobile number" option is not offered.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# Demo allowlist (optional) — for showing sign-in methods before they are live
# ---------------------------------------------------------------------------
# Email codes cannot reach anyone but the Resend account owner until a sending
# domain is verified, and SMS cannot be delivered at all until DLT registration
# completes. Both take time; the features are finished now.
#
# List your own addresses and numbers here and those identifiers may use those
# methods anyway — the code is shown on screen instead of being sent.
#
# Safe only because of the allowlist: an identifier that is not listed is
# refused before a code is generated, so nobody can type their own address and
# read a code back. A configured provider always wins, so this turns itself off
# per channel as each goes live. Unset means no identifiers, which means the
# mechanism does nothing. REMOVE IT once both channels are live.
#
#   DEMO_IDENTIFIERS=you@example.com,9876543210
DEMO_IDENTIFIERS=

# ---------------------------------------------------------------------------
# Order notifications
# ---------------------------------------------------------------------------
# Where the shop's own copy of each order goes. The customer's confirmation is
# sent regardless (it needs GMAIL_* or RESEND_* above); this is the alert to you.
OWNER_EMAIL=

# WhatsApp alerts via Meta's Cloud API — developers.facebook.com/apps
#   WHATSAPP_TOKEN            permanent access token for the app
#   WHATSAPP_PHONE_NUMBER_ID  the sending number's id, not the number itself
#   WHATSAPP_TO               where alerts go, with country code and no +, e.g. 91XXXXXXXXXX
#
# A business-initiated message outside a 24-hour window must use an approved
# template or it is silently dropped. Name yours here once it is approved;
# without it, alerts only arrive while a conversation window is already open.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Public site URL, used to build the order link inside the confirmation email.
NEXT_PUBLIC_SITE_URL=https://avyora-beauty.vercel.app

# ---------------------------------------------------------------------------
# Abandoned reservation sweep
# ---------------------------------------------------------------------------
# Stock is reserved when an order is created, before payment. Cancellation and
# payment failure return it — but a customer who simply closes the tab fires
# neither, so those units would sit reserved forever.
#
# Vercel Cron calls /api/cron/sweep every 15 minutes (see vercel.json) and the
# endpoint requires this secret: left open, it would be a way for anyone to
# cancel pending orders on demand. Without it set, the sweep refuses to run
# rather than running unauthenticated.
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# GST invoicing
# ---------------------------------------------------------------------------
# Your registration. Without SELLER_GSTIN the invoice page says so plainly
# rather than printing an invalid tax invoice.
#
# SELLER_STATE decides the tax split: a buyer in the same state is billed
# CGST + SGST, anyone else IGST. Same total either way — different heads at
# filing time.
SELLER_NAME=Avyora
SELLER_GSTIN=
SELLER_STATE=Maharashtra

# ---------------------------------------------------------------------------
# Payments (Cashfree)
# ---------------------------------------------------------------------------
# Cashfree Merchant Dashboard -> Developers -> API Keys. Start with sandbox
# keys (CASHFREE_ENV=sandbox); production keys need completed KYC and
# CASHFREE_ENV=production.
#
# Without these, checkout still works but offers cash on delivery only.
#
# Webhook: Dashboard -> Developers -> Webhooks -> Add
#   URL:    https://YOUR-DOMAIN/api/webhooks/cashfree   (payment events)
# Cashfree signs webhooks with the secret key above; no separate secret.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ---------------------------------------------------------------------------
# Payments (Razorpay, legacy): only to reconcile orders taken before Cashfree
# ---------------------------------------------------------------------------
# Razorpay Dashboard -> Settings -> API Keys -> Generate Key.
# Start in Test mode; live keys need completed KYC.
# The secret is shown once at creation and never again.
#
# Without these, checkout still works but offers cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
#   URL:    https://YOUR-DOMAIN/api/webhooks/razorpay
#   Events: payment.captured, payment.failed
# The webhook is the authoritative record of payment: the browser callback can
# be lost (closed tab, dead connection), so money must not depend on it.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# After setting DATABASE_URL
# ---------------------------------------------------------------------------
#   npm run db:migrate            apply the schema
#   npm run db:seed-inventory 25  create stock rows with 25 units each
#
# Stock control only takes effect once inventory rows exist: a SKU with no row
# is treated as unlimited, so the shop keeps working until you opt in.

# ---------------------------------------------------------------------------
# Error monitoring (optional)
# ---------------------------------------------------------------------------
# sentry.io -> create a project -> Client Keys (DSN).
#
# Without a DSN nothing is sent anywhere and the SDK never initialises;
# structured JSON error logs still go to stdout, which Vercel collects today
# and CloudWatch will collect after the AWS move.
#
# NEXT_PUBLIC_ is required for the browser half. Session replay is disabled in
# code: it records what customers type, which on checkout means addresses.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Shared cache (optional) ------------------------------------------------
# Redis over HTTPS (Upstash REST API). Unset: each instance uses only its own
# small in-memory cache and reads Postgres on a miss. Postgres stays the record
# either way; losing Redis costs speed, never correctness.
REDIS_REST_URL=
REDIS_REST_TOKEN=
# Development/tests only: CACHE_L2=memory uses an in-process stand-in for Redis.
CACHE_L2=

# --- Object storage for CMS media (optional) -------------------------------
# Any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2, MinIO).
# Unset in development: files go to public/media-local/.
# Unset in production: uploads are switched off, with a message saying so.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# The public URL prefix objects are served from (bucket domain or CDN).
STORAGE_PUBLIC_BASE_URL=
# Analytics landing zone: a separate, private bucket on the same endpoint.
# Never the media bucket, which is public. Unset: no export (development
# writes to .data/lake instead).
STORAGE_ANALYTICS_BUCKET=

# --- Event stream (optional) -----------------------------------------------
# Kafka via the Confluent REST Proxy v3 API. Unset: nothing is relayed and
# checkout is unaffected either way; the stream is downstream of the outbox.
KAFKA_REST_URL=
KAFKA_CLUSTER_ID=
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_TOPIC_PREFIX=avyora

# --- Read replica (optional) -----------------------------------------------
# Heavy reads that tolerate seconds of lag (sales reports) go here. Unset:
# everything reads the primary. Checkout, carts, payments and cache fills
# always read the primary regardless.
DATABASE_READ_URL=
# Beyond this many seconds behind, reads go back to the primary.
DATABASE_READ_MAX_LAG_SECONDS=30

# ---------------------------------------------------------------------------
# Rate limiting (prompt 10)
# ---------------------------------------------------------------------------
# Secret for hashing limiter keys (IPs, emails). Falls back to AUTH_SECRET.
# Changing it restarts every rate-limit window.
RATE_LIMIT_KEY_SECRET=
# Only on a proxy that OVERWRITES X-Forwarded-For (ALB, CloudFront). Vercel is
# detected automatically. Leave unset elsewhere: the header is spoofable.
# TRUSTED_PROXY=x-forwarded-for
# Optional JSON overrides of the starting limits, e.g.
# RATE_LIMIT_OVERRIDES={"login":{"limit":8,"ipLimit":40}}
RATE_LIMIT_OVERRIDES=

# Optional face photo step (/scan) and its entry in the routine finder. Off by
# default. With only this flag, photos are checked in the browser and never sent.
# NEXT_PUBLIC_FACE_SCAN=1
# Hosted upload (signed-in accounts, photo consent, durable quotas). Also needs
# private storage. No analysis runs: no evaluated model exists (see prompt 27).
# FACE_SCAN_HOSTED=1
# Private scan storage. Only `local` exists (a git-ignored .private-storage/
# folder, for development); hosted storage is not configured, so leave unset in
# production and hosted upload stays off.
# PRIVATE_STORAGE=local
# Signs short-lived private read tokens. Falls back to AUTH_SECRET.
# PRIVATE_STORAGE_SIGNING_SECRET=

# Newsletter, double opt-in (needs RESEND_API_KEY and EMAIL_FROM and migration
# 0021). NEXT_PUBLIC_NEWSLETTER shows the footer form; NEWSLETTER_ENABLED opens
# the endpoint. Both off by default. No sending tool is included: subscribers
# are a list for the owner's chosen email service, with unsubscribe honoured.
# NEXT_PUBLIC_NEWSLETTER=1
# NEWSLETTER_ENABLED=1

# Catalogue (lib/catalogue-mode.ts). Build-time. `sample` (default) shows the
# development catalogue labelled as samples; production builds refuse orders
# for it unless ALLOW_SAMPLE_ORDERS=1 (staging with sandbox payments only).
# `verified` shows only onboarded products (src/data/verified-products.ts):
# empty until real products are added, with honest empty states.
# NEXT_PUBLIC_CATALOGUE_MODE=sample
# ALLOW_SAMPLE_ORDERS=1

# Photo retention backstop: call GET /api/cron/scan-retention (Bearer CRON_SECRET)
# at least hourly before enabling hosted analysis. The daily sweep alone cannot
# hold a 24-hour promise. Today photos are deleted in the upload request.
