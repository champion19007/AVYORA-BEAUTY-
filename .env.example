# Admin authentication.
#
# Generate real values with:
#   node scripts/hash-password.mjs 'your-admin-password'
#
# Set these in Vercel under Project Settings -> Environment Variables.
# Without them, admin login fails closed and /admin is unreachable.

ADMIN_USERNAME=admin

# PBKDF2 hash of the admin password, as pbkdf2:<iterations>:<salt>:<hash>.
# The password itself is never stored.
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. At least 32 characters.
# Changing it invalidates all existing admin sessions.
SESSION_SECRET=
